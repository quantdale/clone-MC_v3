{
  "name": "voxel-game",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A browser-based Three.js voxel sandbox game (Minecraft-inspired) with procedural terrain, chunk streaming, block interaction, and a polished UI.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "validate-state": "node scripts/validate-state.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.169.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.13.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.11.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "optionalDependencies": {
    "@rollup/rollup-win32-x64-msvc": "4.62.4"
  }
}
