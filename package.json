{
  "name": "voxel-game",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.8.2",
  "description": "A browser-based Three.js voxel sandbox game (Minecraft-inspired) with procedural terrain, chunk streaming, block interaction, and a polished UI.",
  "scripts": {
    "verify:deps": "node scripts/check-install.mjs",
    "verify:visual-goldens": "node scripts/check-visual-goldens.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:perf": "node scripts/perf/canonical-perf-run.mjs",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "validate-state": "node scripts/validate-state.mjs",
    "verify:file-audit": "node scripts/validate-file-audit.mjs openspec/hardening/2026-08-23-exhaustive-repository-certification/file-audit-manifest.json",
    "gen:file-audit": "node scripts/gen-file-audit.mjs",
    "verify:orphans": "node scripts/orphan-check.mjs",
    "verify:mcp": "node scripts/verify-mcp-addons.mjs",
    "verify:inventory": "node scripts/audit-inventory.mjs",
    "evidence:archive": "node scripts/build-evidence-archive.mjs",
    "verify:all": "node scripts/verify-all.mjs"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.169.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.13.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.11.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  },
  "optionalDependencies": {
    "@rollup/rollup-win32-x64-msvc": "4.62.4"
  }
}
